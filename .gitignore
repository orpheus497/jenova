# Jenova — .gitignore

# --- Build artifacts ---------------------------------------------------------
# Built by `nimble core`, `nimble gui`, `nimble llama` and `nimble web`.
# llama.cpp's own build tree, `external/llama.cpp/build/`, is ignored by the
# submodule's `.gitignore`.
/bin/jenova
/bin/jenova-core
/bin/llama-server
/public/
/external/ext_bin/
nimcache/

*.o
*.so
*.a
*.dylib

# --- jvim: TRACKED ON PURPOSE ------------------------------------------------
# `jvim/` is Jenova's own Neovim configuration (NVIM_APPNAME=jvim, loaded from
# this repository) with its vendored plugins in `jvim/pack/`, tracked so the
# editor needs no package manager and no network on first start. Only Neovim's
# runtime noise under it is ignored; a rule that matches a plugin's own file
# drops it from every clone. `*.log` below covers `jvim/nvim.log`.
/jvim/**/*.shada
/jvim/**/Session.vim
/jvim/**/.netrwhist
/jvim/**/undo/
/jvim/**/[._]*.s[a-v][a-z]
/jvim/**/[._]*.un~
/jvim/**/.DS_Store?
/jvim/**/._*
/jvim/**/.Spotlight-V100
/jvim/**/.Trashes
/jvim/**/ehthumbs.db

# --- Models (never commit multi-GB weights) ----------------------------------
*.gguf
*.safetensors
*.onnx
*.pt
*.pth
*.h5
*.tflite
*.bin

# --- Runtime data and private state ------------------------------------------
/var/log/**
/var/cache/**
!/var/log/.gitkeep
!/var/cache/.gitkeep
/var/state/
/.system/

# --- AI assistant working directories ----------------------------------------
# `.devdocs/` is deliberately NOT here: the process record is tracked.
.claude/
.crush/
.gemini/
.jenova/
.cursor/
.copilot/
.codeium/
.aider/
.continue/
.tabnine/
.windsurf/

# --- Environment, keys and secrets -------------------------------------------
.env
.env.*
*.key
*.pem
*.p12
*.pfx
*.crt
*.csr
id_rsa
id_ed25519
*.secret
*_secret*
*.token
credentials.json
secrets.json
auth.json

# --- Local configuration overrides -------------------------------------------
# `jenova.local.conf` is the user's machine file; `hardware.applyProfile` never
# writes it, and `hardware-selftest` asserts that.
/etc/jenova.conf.local
/etc/jenova.conf.bak.*
/etc/jenova.local.conf

# --- Databases and session data ----------------------------------------------
*.sqlite
*.sqlite3
*.db
*.jsonl
.bash_history
.zsh_history
.history

# --- Logs, archives and crash dumps ------------------------------------------
*.log
*.tar
*.tar.gz
*.tgz
*.zip
*.7z
*.bak
*.tmp
# Crash dumps are `core` or `core.<pid>`; `core.*` would also hide source files
# such as nvim-cmp's `lua/cmp/core.lua`.
core
core.[0-9]*
*.dmp

# --- System and IDE ----------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
*.iml
*~
*.swp
*.swo
\#*\#

# --- Web UI build output -----------------------------------------------------
/jca_web/node_modules/
/jca_web/.svelte-kit/
/jca_web/build/
/jca_web/src-tauri/target/
