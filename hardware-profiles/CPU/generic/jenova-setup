#!/bin/sh

# Script function and purpose: One-time FreeBSD system configuration for the
# CPU-only Jenova profile.
# Hardware: CPU-only inference (no usable Vulkan device)
# Run with: sudo ./jenova-setup
#
# Configures:
#   - CPU frequency policy held at maximum for sustained inference
#   - ZFS ARC cap and page-daemon tuning so the model is not paged against
#
# Hardware context:
#   With no GPU the model weights live in ordinary RAM and every token is
#   computed on the CPU. The two things that hurt are the CPU dropping to a
#   lower frequency between bursts, and the ZFS ARC growing into the memory the
#   model needs. Both are addressed below.
#
#   This script was Linux-only until 2026-08-31 (`cpupower`, `/sys/devices`,
#   `/sys/kernel/mm/transparent_hugepage`, `numactl`). None of those exist on
#   FreeBSD, so on the only platform this project supports it reported success
#   while configuring nothing (TODOS T-9).

set -e

if [ "$(id -u)" -ne 0 ]; then
    echo "Error: must run as root (sudo ./jenova-setup)"
    exit 1
fi

if [ "$(sysctl -n kern.ostype 2>/dev/null)" != "FreeBSD" ]; then
    echo "Error: this profile targets FreeBSD only."
    exit 1
fi

echo "=== jenova-setup: configuring CPU-only inference for Jenova CA ==="
echo "=== Hardware: Generic multi-core CPU, no usable Vulkan device ==="
echo ""

CHANGED=0

_SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
_CUR_DIR="$_SCRIPT_DIR"
while [ "$_CUR_DIR" != "/" ]; do
    if [ -f "$_CUR_DIR/common-setup.sh" ]; then
        . "$_CUR_DIR/common-setup.sh"
        break
    fi
    _CUR_DIR="$(dirname "$_CUR_DIR")"
done

# Function purpose: set a sysctl and persist it, reporting whether it changed.
# Shared shape with the other profiles' jenova-setup scripts so their output is
# comparable.
apply_sysctl() {
    _key="$1"
    _val="$2"
    _desc="$3"
    if ! sysctl -n "$_key" >/dev/null 2>&1; then
        echo "[skip] $_key not present on this kernel ($_desc)"
        return 0
    fi
    _current=$(sysctl -n "$_key" 2>/dev/null || echo "?")
    if [ "$_current" = "$_val" ]; then
        echo "[ok]  $_key=$_val ($_desc)"
    else
        echo "[fix] $_key: $_current -> $_val ($_desc)"
        sysctl "$_key=$_val" >/dev/null
        sysctl_persist "$_key=$_val"
        CHANGED=1
    fi
}

# =========================================================================
# 1. CPU frequency policy
# =========================================================================
echo "--- CPU frequency policy ---"

# Action purpose: FreeBSD's equivalent of a "performance governor" is powerd(8)
# in maximum mode, or cpufreq(4) driven directly through dev.cpu.0.freq. powerd
# is preferred because it is a supervised service that survives a reboot once
# enabled; the direct cpufreq write is the fallback for a kernel with cpufreq
# but no powerd, and it is not persistent on its own.
if [ -z "$(sysctl -n dev.cpu.0.freq_levels 2>/dev/null)" ]; then
    echo "[info] cpufreq(4) reports no frequency levels — this CPU is not"
    echo "       software-throttled, so there is nothing to pin."
elif command -v powerd >/dev/null 2>&1; then
    if [ "$(sysrc -n powerd_enable 2>/dev/null)" = "YES" ] &&
       [ "$(sysrc -n powerd_flags 2>/dev/null)" = "-a maximum -b maximum -n maximum" ] &&
       service powerd status >/dev/null 2>&1; then
        echo "[ok]  powerd already running in maximum mode"
    else
        echo "[fix] powerd: enabling in maximum mode (AC, battery and unknown)"
        sysrc powerd_enable=YES >/dev/null
        sysrc powerd_flags="-a maximum -b maximum -n maximum" >/dev/null
        service powerd restart >/dev/null 2>&1 || service powerd start >/dev/null 2>&1
        CHANGED=1
        echo "[ok]  powerd enabled and started"
    fi
else
    # No powerd: pin every core to its highest advertised frequency directly.
    _top=$(sysctl -n dev.cpu.0.freq_levels 2>/dev/null | awk '{print $1}' | cut -d/ -f1)
    if [ -n "$_top" ]; then
        _cur=$(sysctl -n dev.cpu.0.freq 2>/dev/null || echo "?")
        if [ "$_cur" = "$_top" ]; then
            echo "[ok]  dev.cpu.0.freq already at maximum ($_top MHz)"
        else
            echo "[fix] dev.cpu.0.freq: $_cur -> $_top MHz (cpufreq, no powerd)"
            sysctl "dev.cpu.0.freq=$_top" >/dev/null
            sysctl_persist "dev.cpu.0.freq=$_top"
            CHANGED=1
        fi
        echo "[info] powerd is not installed; install it for a supervised policy."
    fi
fi

# =========================================================================
# 2. Memory management
# =========================================================================
echo ""
echo "--- Memory management ---"

# Action purpose: with no GPU the model weights are ordinary anonymous memory,
# and the ZFS ARC will otherwise grow to fill RAM and force them out. 2 GiB is
# the cap the other profiles use. On UFS there is no ARC and the sysctl is
# absent, which apply_sysctl reports as a skip rather than a failure.
apply_sysctl vfs.zfs.arc_max 2147483648 "ZFS ARC max 2 GiB"

# The model is read once at load and then resident. Panicking on OOM instead of
# reclaiming turns a tight memory moment into a downed machine.
apply_sysctl vm.panic_on_oom 0 "no kernel panic on OOM"
apply_sysctl vm.pageout_oom_seq 8 "OOM kill after 8 failed pageout sequences"

# FreeBSD has no transparent-huge-page knob to disable; superpages are managed
# by the VM and reservation-based, and are a benefit rather than the latency
# hazard THP is on Linux. Reported so the absence is not mistaken for an
# oversight.
if [ "$(sysctl -n vm.pmap.pg_ps_enabled 2>/dev/null)" = "1" ]; then
    echo "[ok]  superpages enabled (vm.pmap.pg_ps_enabled=1) — left as is"
fi

echo ""
if [ "$CHANGED" -gt 0 ]; then
    echo "System configuration updated and persisted."
else
    echo "Nothing to change. System already configured for CPU-only inference."
fi

echo ""
echo "CPU-only optimization notes:"
echo "   * CPU frequency held at maximum for sustained workloads"
echo "   * ZFS ARC capped so it does not compete with the model for RAM"
echo "   * Thread counts come from the profile's jenova.conf (THREADS,"
echo "     THREADS_BATCH), not from this script"
echo "   * Monitor CPU temperature during long inference sessions"
